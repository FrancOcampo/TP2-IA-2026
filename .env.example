# --- Proveedor LLM ---
# Valores: "groq" (default) | "gemini" | "openrouter" | "openai_compat"  (ADR-0020)
#   openrouter    -> OPENROUTER_API_KEY (modelo por defecto: deepseek/deepseek-v4-flash, ~0,0005 USD por analisis)
#   openai_compat -> LLM_API_KEY + LLM_BASE_URL (DeepSeek, Cerebras, Mistral, Ollama local...)
LLM_PROVIDER=groq

# Modelo a usar (opcional; si no se define, cada proveedor usa su default)
# Defaults en agents/llm_factory.py → DEFAULT_MODELS
# groq default:   openai/gpt-oss-120b (Llama 3.3 70B fue dado de baja en Groq)
# gemini default: gemma-4-31b-it
# LLM_MODEL=

# Modo de los agentes (ADR-0015):
#   lean  (default) → pocas llamadas al LLM; entra en el free tier de Groq (8000 tokens/min)
#   react           → loops ReAct completos (Monitor y Clínico eligen todas sus tools); requiere más cuota
# AGENT_MODE=lean
# Salida del LLM: límite de tokens y esfuerzo de razonamiento (solo modelos gpt-oss)
# Modelos de respaldo si el principal agota la cuota o no existe (ADR-0016); vacío = sin respaldo
# LLM_FALLBACK_MODELS=groq:openai/gpt-oss-120b   (proveedor:modelo; con openrouter es el default)
# LLM_MAX_TOKENS=4096
# LLM_REASONING_EFFORT=low

# --- Credenciales ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com   (solo openai_compat)
# OPENROUTER_DATA_COLLECTION=deny   (deny = solo proveedores que no guardan ni entrenan con los datos)
# LLM_TIMEOUT_S=45
GOOGLE_API_KEY=        # también se acepta GEMINI_API_KEY

LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=tp2-diabetes


LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="tp2-diabetes"

# Embeddings del RAG (ADR-0017). Default: multilingual (fastembed, ONNX en proceso, ~220 MB la primera vez).
# Alternativas: local (MiniLM-L6, solo inglés) | ollama.
# EMBEDDING_PROVIDER=multilingual
# OLLAMA_URL=http://localhost:11434

# Historial de pacientes (ADR-0005). Default: SQLite local en data/tp2.db, sin servicios.
# HISTORY_BACKEND=sqlite
# HISTORY_DB_PATH=data/tp2.db
#
# Con HISTORY_BACKEND=mongo se usa MongoDB en MONGO_URI (Docker: docker/docker-compose.yml).
# En Windows, 127.0.0.1 evita demoras por la resolución IPv6 de localhost.
MONGO_URI=mongodb://127.0.0.1:27017